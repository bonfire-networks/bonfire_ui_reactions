<Bonfire.UI.Common.OpenModalLive
  :if={@object}
  id={deterministic_dom_id("pin_modal", id(@object), to_string(@scope), @parent_id)}
  no_actions
  title_text={modal_title(assigns)}
  open_btn_wrapper_class={if @as_icon,
    do: "btn btn-ghost btn-circle btn-sm text-muted hover:text-base-content",
    else: "flex items-center gap-2 text-sm w-full flex-1"}
>
  {#if @scope == :instance}
    {!-- the spotlight's pinned state isn't preloaded with the page: `PinModalLive` looks it up when the modal opens --}
    <StatefulComponent
      id={deterministic_dom_id("pin_modal_content", id(@object), to_string(@scope), @parent_id)}
      module={maybe_component(Bonfire.UI.Reactions.PinModalLive, @__context__)}
      object={@object}
      scope={@scope}
      scope_object={@scope_object}
      pinned?={@pinned?}
      parent_component={@component}
      __context__={@__context__}
    />
  {#else}
    <Bonfire.UI.Reactions.PinButtonLive
      object={@object}
      scope={@scope}
      scope_object={@scope_object}
      pinned?={pinned?(assigns)}
      component={@component}
    />
  {/if}

  <:open_btn>
    <div class="text-left flex items-center w-full gap-3 text-sm">
      {#if @scope == :thread_answer}
        <#Icon iconify="mdi:message-check" class="size-4 shrink-0 text-muted" />
      {#elseif @as_icon and pinned?(assigns)}
        <#Icon iconify="ph:push-pin-simple-slash" class="size-4 shrink-0 text-muted" />
      {#else}
        <#Icon iconify="ph:push-pin-duotone" class="size-4 shrink-0 text-muted" />
      {/if}
      <span class={"flex-1 truncate", "sr-only": @as_icon}>{cond do
          @scope == :instance -> labels(@scope).title
          pinned?(assigns) -> labels(@scope).unpin
          true -> labels(@scope).pin
        end}</span>
    </div>
  </:open_btn>
</Bonfire.UI.Common.OpenModalLive>

<div
  id={@id}
  data-id="instance_pinned_widget"
  class={@class, hidden: @entries == [] and @hide_empty}
>
  <Bonfire.UI.Common.WidgetBlockLive
    :if={@entries != [] or !@hide_empty}
    class={@wrapper_class || "w-full relative bg-transparent"}
    empty={@entries == []}
    empty_icon="ph:push-pin-fill"
    empty_message={l("Nothing in the spotlight yet. Pinned posts from this instance will show up here.")}
    widget_title={@title || l("Pinned")}
    title_class={@title_class}
    heading_class={@heading_class}
  >
    <:action>
      <Bonfire.UI.Common.CarouselArrowsLive track={"#{@id}-track"} count={length(@entries)} />
    </:action>

    <Bonfire.UI.Common.CarouselLive
      id={"#{@id}-track"}
      items={@entries}
      visible_items={@visible_items}
      class={@carousel_class}
    >
      <:card :let={item: entry}>
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Reactions.PinnedCardLive, @__context__)}
          activity={entry.activity}
          participants={e(entry, :participants, [])}
          participants_more_count={e(entry, :participants_more_count, 0)}
          scope={@scope}
          scope_object={id(@scope_object)}
          can_unpin={@can_unpin}
        />
      </:card>
    </Bonfire.UI.Common.CarouselLive>
  </Bonfire.UI.Common.WidgetBlockLive>
</div>

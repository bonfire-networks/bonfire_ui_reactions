<div
  class={"w-full bg-base-200", "max-w-[720px] mx-auto px-2 sm:px-0": !@embed?}
  data-theme={@embed_theme || Bonfire.UI.Common.ThemeHelper.current_theme(assigns)}
  data-embed-links={if @embed?, do: "_blank"}
>
  <Bonfire.UI.Reactions.PinnedCarouselLive
    id="instance_pins_carousel"
    title={@widget_title}
    visible_items={@visible_items}
  />
</div>
